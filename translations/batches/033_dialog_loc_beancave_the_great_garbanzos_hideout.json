  "strings": {
    "It wasn't a pillow at all, but a bag of beans!": {
      "pl": "To w ogóle nie poduszka, tylko worek fasoli!",
      "contexts": [
        "data.json:scripts.beancave_bed.e"
      ],
      "category": "dialog"
    },
    "It's a revolting sofa.": {
      "pl": "To obrzydliwa sofa.",
      "contexts": [
        "data.json:scripts.beancave_sofa.popup"
      ],
      "category": "dialog"
    },
    "It's the Great Garbanzo's bed.": {
      "pl": "To łóżko Wielkiego Garbanzo.",
      "contexts": [
        "data.json:scripts.beancave_bed.popup"
      ],
      "category": "dialog"
    },
    "Look under the pillow": {
      "pl": "Zajrzyj pod poduszkę",
      "contexts": [
        "data.json:scripts.beancave_bed.popup"
      ],
      "category": "dialog"
    },
    "Most of these books are too fragile to touch, but there's one that looks like it's in decent shape.": {
      "pl": "Większość tych książek jest zbyt delikatna, żeby ich dotykać, ale jedna wygląda na całkiem zdatną.",
      "contexts": [
        "data.json:scripts.beancave_bookshelf.popup"
      ],
      "category": "dialog"
    },
    "The sign says: KEEP OUT (unless you are The Great Garbanzo)": {
      "pl": "Znak głosi: WSTĘP WZBRONIONY (chyba że jesteś Wielkim Garbanzo)",
      "contexts": [
        "data.json:scripts.beancave_sign.popup"
      ],
      "category": "dialog"
    },
    "You find some loose beans in the cushions.": {
      "pl": "W poduszkach kilka luźnych fasoli.",
      "contexts": [
        "data.json:scripts.beancave_sofa.e"
      ],
      "category": "dialog"
    }
  }
}
