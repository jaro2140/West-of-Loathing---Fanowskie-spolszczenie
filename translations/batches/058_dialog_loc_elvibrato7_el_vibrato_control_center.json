      "category": "dialog"
    },
    "It's a perfect fit!": {
      "pl": "Idealnie pasuje!",
      "contexts": [
        "data.json:scripts.elvibrato7_crowntable.e"
      ],
      "category": "dialog"
    },
    "Place it in the machine": {
      "pl": "Włóż to do maszyny",
      "contexts": [
        "data.json:scripts.elvibrato7_shaft.placecross"
      ],
      "category": "dialog"
    },
    "Take the crown": {
      "pl": "Weź koronę",
