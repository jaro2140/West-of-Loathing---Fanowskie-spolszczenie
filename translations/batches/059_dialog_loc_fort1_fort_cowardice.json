      "pl": "%fort1_cabinet/$mult1$%\\n%fort1_cabinet/$mult2$%\\n%fort1_cabinet/$mult3$%\\n%fort1_cabinet/$mult4$%\\n%fort1_cabinet/$mult5$%\\n%fort1_cabinet/$mult6$%\\n%fort1_cabinet/$mult7$%",
